generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccessLevel {
  NONE
  READ
  WRITE
}

enum AuditAction {
  REGISTRATION
  LOGIN
  LOGOUT
  FAILED_LOGIN
  FAILED_AUTHORIZATION
  USER_APPROVED
  USER_DELETED
  USER_PASSWORD_CHANGED
  PERMISSION_CHANGED
  MAP_UPDATED
  MARKER_CREATED
  MARKER_UPDATED
  MARKER_DELETED
  MARKER_RESTORED
  MARKER_CLEANED_UP
  MAP_DATA_ACCESSED
  SHARE_LINK_CREATED
}

enum AuditTargetType {
  USER
  MAP
  TOWER
  DEED
  NOTE
  RIFT
  CAMP
  MINEDOOR
  LOCATE_SOUL
  PATH
  SESSION
  SYSTEM
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id                 String              @id @default(cuid())
  watermarkNumber    Int?                @unique
  username           String              @unique
  passwordHash       String
  approvalStatus     ApprovalStatus      @default(PENDING)
  accessLevel        AccessLevel         @default(NONE)
  isAdmin            Boolean             @default(false)
  approvedAt         DateTime?
  approvedByUserId   String?
  approvedBy         User?               @relation("UserApprovals", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedUsers      User[]              @relation("UserApprovals")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdTowers      Tower[]             @relation("TowerCreatedBy")
  updatedTowers      Tower[]             @relation("TowerUpdatedBy")
  deletedTowers      Tower[]             @relation("TowerDeletedBy")
  createdDeeds       Deed[]              @relation("DeedCreatedBy")
  updatedDeeds       Deed[]              @relation("DeedUpdatedBy")
  deletedDeeds       Deed[]              @relation("DeedDeletedBy")
  createdNotes       Note[]              @relation("NoteCreatedBy")
  updatedNotes       Note[]              @relation("NoteUpdatedBy")
  deletedNotes       Note[]              @relation("NoteDeletedBy")
  createdRifts       Rift[]              @relation("RiftCreatedBy")
  updatedRifts       Rift[]              @relation("RiftUpdatedBy")
  deletedRifts       Rift[]              @relation("RiftDeletedBy")
  createdCamps       Camp[]              @relation("CampCreatedBy")
  updatedCamps       Camp[]              @relation("CampUpdatedBy")
  deletedCamps       Camp[]              @relation("CampDeletedBy")
  createdMinedoors   Minedoor[]          @relation("MinedoorCreatedBy")
  updatedMinedoors   Minedoor[]          @relation("MinedoorUpdatedBy")
  deletedMinedoors   Minedoor[]          @relation("MinedoorDeletedBy")
  createdLocateSouls LocateSoul[]        @relation("LocateSoulCreatedBy")
  updatedLocateSouls LocateSoul[]        @relation("LocateSoulUpdatedBy")
  deletedLocateSouls LocateSoul[]        @relation("LocateSoulDeletedBy")
  createdPaths       PathMarker[]        @relation("PathCreatedBy")
  updatedPaths       PathMarker[]        @relation("PathUpdatedBy")
  deletedPaths       PathMarker[]        @relation("PathDeletedBy")
  auditEvents        AuditEvent[]        @relation("AuditActor")
  sessions           Session[]
  shareLinks         ShareLink[]
  mapSettings        UserMapSettings[]
  mapPermissions     UserMapPermission[]
  canaryMarkers      CanaryMarker[]
  alerts             Alert[]             @relation("AlertActor")
  acknowledgedAlerts Alert[]             @relation("AlertAcknowledgedBy")
  resolvedAlerts     Alert[]             @relation("AlertResolvedBy")

  @@index([approvalStatus])
  @@index([accessLevel])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ShareLink {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  mapId           String
  map             Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  layerId         String?
  settings        Json
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([mapId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@map("share_links")
}

model Map {
  id              String              @id @default(cuid())
  name            String
  imagePath       String
  widthPx         Int
  heightPx        Int
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  layers          MapLayer[]
  towers          Tower[]
  deeds           Deed[]
  notes           Note[]
  rifts           Rift[]
  camps           Camp[]
  minedoors       Minedoor[]
  locateSouls     LocateSoul[]
  paths           PathMarker[]
  noteCategories  NoteCategory[]
  auditEvents     AuditEvent[]
  events          Event[]
  userSettings    UserMapSettings[]
  userPermissions UserMapPermission[]
  canaryMarkers   CanaryMarker[]
  alerts          Alert[]
  shareLinks      ShareLink[]

  @@index([isActive])
  @@map("maps")
}

model MapLayer {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name      String
  imagePath String
  widthPx   Int
  heightPx  Int
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mapId, name])
  @@index([mapId, sortOrder])
  @@map("map_layers")
}

model Tower {
  id               String    @id @default(cuid())
  mapId            String
  map              Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x                Int
  y                Int
  qlHundredths     Int?
  damageHundredths Int?
  makerName        String
  makerNumber      String
  planned          Boolean   @default(false)
  towerType        String    @default("Freedom Isles")
  createdByUserId  String?
  createdBy        User?     @relation("TowerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?
  updatedBy        User?     @relation("TowerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  deletedByUserId  String?
  deletedBy        User?     @relation("TowerDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("towers")
}

model Deed {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x               Int
  y               Int
  name            String
  foundingDate    DateTime? @db.Date
  north           Int
  perimeter       Int       @default(5)
  west            Int
  east            Int
  south           Int
  founder         String
  createdByUserId String?
  createdBy       User?     @relation("DeedCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("DeedUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("DeedDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("deeds")
}

model Note {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x               Int
  y               Int
  title           String    @default("Untitled")
  category        String    @default("General")
  text            String
  createdByUserId String?
  createdBy       User?     @relation("NoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("NoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("NoteDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("notes")
}

model Rift {
  id                String    @id @default(cuid())
  mapId             String
  map               Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x                 Int
  y                 Int
  arrivalDate       DateTime? @db.Date
  estimatedRiftTime DateTime?
  notes             String    @default("")
  createdByUserId   String?
  createdBy         User?     @relation("RiftCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId   String?
  updatedBy         User?     @relation("RiftUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt         DateTime?
  deletedByUserId   String?
  deletedBy         User?     @relation("RiftDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("rifts")
}

model Camp {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x               Int
  y               Int
  campType        String
  notes           String    @default("")
  createdByUserId String?
  createdBy       User?     @relation("CampCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("CampUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("CampDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("camps")
}

model Minedoor {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x               Int
  y               Int
  strength        String    @default("")
  notes           String    @default("")
  createdByUserId String?
  createdBy       User?     @relation("MinedoorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("MinedoorUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("MinedoorDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("minedoors")
}

model LocateSoul {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x               Int
  y               Int
  targetName      String
  casterFacing    String
  direction       String
  distanceBand    String
  notes           String    @default("")
  createdByUserId String?
  createdBy       User?     @relation("LocateSoulCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("LocateSoulUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("LocateSoulDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@map("locate_souls")
}

model PathMarker {
  id              String    @id @default(cuid())
  mapId           String
  map             Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  pathType        String
  x               Int
  y               Int
  name            String    @default("")
  width           Int       @default(1)
  notes           String    @default("")
  points          Json
  createdByUserId String?
  createdBy       User?     @relation("PathCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?     @relation("PathUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("PathDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mapId, deletedAt])
  @@index([deleteExpiresAt])
  @@index([pathType])
  @@map("path_markers")
}

model NoteCategory {
  id          String   @id @default(cuid())
  mapId       String
  map         Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  markerShape String   @default("circle")
  pipSize     Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mapId, name])
  @@index([mapId])
  @@map("note_categories")
}

model UserMapSettings {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mapId])
  @@index([mapId])
  @@map("user_map_settings")
}

model UserMapPermission {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId       String
  map         Map         @relation(fields: [mapId], references: [id], onDelete: Cascade)
  accessLevel AccessLevel @default(NONE)
  isOperator  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, mapId])
  @@index([mapId])
  @@index([isOperator])
  @@map("user_map_permissions")
}

model AuditEvent {
  id          String          @id @default(cuid())
  actorUserId String?
  actor       User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetType  AuditTargetType
  targetId    String?
  mapId       String?
  map         Map?            @relation(fields: [mapId], references: [id], onDelete: SetNull)
  metadata    Json
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([mapId, createdAt])
  @@map("audit_events")
}

model Alert {
  id                   String        @id @default(cuid())
  rule                 String
  severity             AlertSeverity
  status               AlertStatus   @default(OPEN)
  title                String
  description          String
  actorUserId          String?
  actor                User?         @relation("AlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  mapId                String?
  map                  Map?          @relation(fields: [mapId], references: [id], onDelete: SetNull)
  metadata             Json
  acknowledgedByUserId String?
  acknowledgedBy       User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedByUserId     String?
  resolvedBy           User?         @relation("AlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([rule, createdAt])
  @@map("alerts")
}

model DiscordConfig {
  id                  String   @id @default("default")
  webhookUrl          String   @default("")
  enabled             Boolean  @default(false)
  alertSeverityHigh   Boolean  @default(true)
  alertSeverityMedium Boolean  @default(false)
  alertSeverityLow    Boolean  @default(false)
  notifyRegistrations Boolean  @default(false)
  notifyApprovals     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("discord_config")
}

model Event {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  message   String
  timestamp Int
  createdAt DateTime @default(now())

  @@index([mapId, timestamp])
  @@map("events")
}

model CanaryMarker {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      Int
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mapId, userId, slot])
  @@index([mapId, userId])
  @@map("canary_markers")
}
